% +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ %
% #-#-#-#-#-#-#-#-#-#-#-#-#-#-# Action Classification and Information #-#-#-#-#-#-#-#-#-#-#-#-#-#-# %
\NewDocumentCommand{\ActionClassificationInformation}{ mmm }{%
	\noindent
    % ------------------------------------------------------------------
	% Kind and Type
    % ------------------------------------------------------------------
	\begin{tabularx}{\linewidth}
		{
			@{}
			>{\raggedright\arraybackslash}X
			>{\raggedleft\arraybackslash}l
			@{}
		}
		\textbf{#1}
		&
		{\color{actionpanelcurrent}\bfseries\actionpaneltype}
	\end{tabularx}\par\vspace*{1pt}
    % ------------------------------------------------------------------
	% Range and Targets
    % ------------------------------------------------------------------
    \ifthenelse{\equal{#2}{} \AND \equal{#3}{}}{}{%
		\begin{tabularx}{\linewidth}
			{
				@{}
				>{\raggedright\arraybackslash}X
				>{\raggedleft\arraybackslash}l
				@{}
			}
			\ifthenelse{\equal{#2}{}}{}{{\dsglyphs D} #2}
			&
			\ifthenelse{\equal{#3}{}}{}{{\dsglyphs T} #3}
		\end{tabularx}\par\vspace*{3pt}
	}
}%
