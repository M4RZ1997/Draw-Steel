% +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ %
% #-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-# Action Panel Base #-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-# %
\tcbset{
	action panel base/.style={
		enhanced,
    	% --------------------------------------------------------------
		% No Frame or Background (Frame is drawn in Finish)
    	% --------------------------------------------------------------
		frame hidden,
		interior hidden,
		boxrule=0pt,
		sharp corners,
		boxsep=0pt,
    	% --------------------------------------------------------------
		% Margins
    	% --------------------------------------------------------------
		left=7pt,
		right=7pt,
		top=7pt,
		bottom=7pt,
		before skip=5pt,
		after skip=5pt,
    	% --------------------------------------------------------------
		% Font-Size
    	% --------------------------------------------------------------
		fontupper=\scriptsize,
    	% --------------------------------------------------------------
		% Finish (Draw Frame and potential Cost Circle)
    	% --------------------------------------------------------------
		finish={
			\actionpanelframe
			\actionpanelcostcircle
		},
	}
}
% ------------------------------------------------------------------------------------------------- %
% +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ %
% #-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-# Action  Panel #-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-# %
\ExplSyntaxOn
\NewDocumentEnvironment{ActionPanel}{O{} m m O{} O{} m m m +b}{
	% --------------------------------------------------------------
	% Possible Cost
	% --------------------------------------------------------------
	\renewcommand{\actionpanelcost}{#4}
	\group_begin:
	% --------------------------------------------------------------
	% Defaults
	% --------------------------------------------------------------
	\dim_set:Nn
		\l__ds_actionpanel_width_dim
		{\linewidth}
	
	\bool_set_false:N
		\l__ds_actionpanel_fixed_height_bool
	
	% --------------------------------------------------------------
	% Optional width / height
	% --------------------------------------------------------------
	\keys_set:nn{ ds / actionpanel }{#1}
	
	% --------------------------------------------------------------
	% Determine colour and action semantics
	% --------------------------------------------------------------
	\__ds_actionpanel_set_type:n {#2}	
	% --------------------------------------------------------------
	% Begin box
	% --------------------------------------------------------------
	\bool_if:NTF
		\l__ds_actionpanel_fixed_height_bool
	{
		\begin{tcolorbox}[
			action~panel~base,
			width=\dim_use:N \l__ds_actionpanel_width_dim,
			height=\dim_use:N \l__ds_actionpanel_height_dim
		]
	}
	{
		\begin{tcolorbox}[
			action~panel~base,
			width=\dim_use:N \l__ds_actionpanel_width_dim
		]
	}
		% ----------------------------------------------------------
		% Name
		% ----------------------------------------------------------
		\noindent\parbox{\linewidth}{%
			\centering\large\bfseries\scshape{\strut #3}%
		}%
		% ----------------------------------------------------------
		% Major Divider
		% ----------------------------------------------------------
		\OrnamentalDivider{\actionpaneldividertype}
		% ----------------------------------------------------------
		% Description (optional)
		% ----------------------------------------------------------
		\ifthenelse{\equal{#5}{}}{}
		{
			{\itshape #5\par}
			{\color{black}\rule{\linewidth}{0.45pt}}\par\vspace{2pt}
		}
		% ----------------------------------------------------------
		% Action Classification and Information
		% ----------------------------------------------------------
		\ActionClassificationInformation{#6}{#7}{#8}
		% ----------------------------------------------------------
		% Action Body
		% ----------------------------------------------------------
		#9
    \end{tcolorbox}
    \group_end:
}
\ExplSyntaxOff