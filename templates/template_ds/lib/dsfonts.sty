		{ \gilliustwo }
		{ \sffamily }
}


% #-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#  Drop Cap Font  #-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-# %
\newfontfamily\dropcapfont{GoudyInitialen}[%
	Path			=	\PATH templates/template_ds/fonts/goudy_initialen/,%
	Extension	=	.ttf,%
	UprightFont	=	GoudyInitialen,%
]%

\keys_define:nn { ds / fonts }
{
	% Drop caps
	drop-cap-family	.tl_set:N			= \l__ds_drop_cap_family_tl,
	drop-cap-family	.initial:n			= \dropcapfont,
	drop-cap-family	.value_required:n	= true,
	drop-cap-style	.tl_set:N			= \l__ds_drop_cap_style_tl,
	drop-cap-style	.value_required:n	= true,
}

\NewDocumentCommand { \DSSetFonts } { o }
{
	\keys_set:nn { ds / fonts } { #1 }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Font access functions combine the selected family and style
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Miscellaneous
\NewDocumentCommand{\DSFontDropCap}{}
	{ \l__ds_drop_cap_family_tl \l__ds_drop_cap_style_tl }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Drop Caps
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\renewcommand{\LettrineFontHook}
	{ \l__ds_drop_cap_family_tl \l__ds_drop_cap_style_tl }

% Usage: DSDropCapLine[<lettrine options>]{<first letter>}{<small caps line>}
%    It takes trial and error to get the 2nd argument to align with
%    the linebreak. Lettrine package will not play nicely with \FirstLine. See
%    the lettrine package for options.
\NewDocumentCommand{\DSDropCapLine}{ O{} m m }
{
	\lettrine[
		lines   = 4,
		depth   = 0,
		findent = \l__ds_space_dim,
		nindent = 0pt,
		#1
	]
	{#2}
	{#3}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Contour that can break across lines. Can accept \newline to force a break.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\cs_new_protected:Npn \__ds_contour_preserve_space:nn #1#2
{
	\group_begin:
	\seq_set_split:Nnn \l_tmpa_seq { ~ } { #2 }
	\seq_set_map:NNn \l_tmpb_seq \l_tmpa_seq { \exp_not:n {\contour{#1}{##1}} }
	\seq_use:Nn \l_tmpb_seq { ~ }
	\group_end:
}

\NewDocumentCommand{\DSContour}{ O{contourgray} m }
{
	\group_begin:
	\seq_set_split:Nnn \l_tmpa_seq { \newline } { #2 }
	\seq_set_map:NNn \l_tmpb_seq \l_tmpa_seq { \exp_not:n {\__ds_contour_preserve_space:nn{#1}{##1}} }
	\seq_use:Nn \l_tmpb_seq { \newline }
	\group_end:
}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Custom "to-upper-case" Macro
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\cs_new_protected:Npn \my_if_uppercase:nTF #1#2#3
  {
    \str_if_eq:eeTF { \tl_upper_case:n {#1} } {#1}
      {
        \str_if_eq:eeTF { \tl_lower_case:n {#1} } {#1}
          { #3 } % not a cased letter
          { #2 } % uppercase letter
      }
      { #3 }
  }