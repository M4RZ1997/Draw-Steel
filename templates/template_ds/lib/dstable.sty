\RequirePackage{xcolor}
\RequirePackage{tabularray}

% --------------------------------------------------------------------------
% Special Columns
% --------------------------------------------------------------------------

\newcolumntype {Y} { > {\centering\arraybackslash } X }
\newcolumntype {R} { > {\raggedleft\arraybackslash } X }
\newcolumntype {`} { > {\global\let\currentrowstyle\relax } }
\newcolumntype {^} { > {\currentrowstyle} }

% --------------------------------------------------------------------------
% Colours
% --------------------------------------------------------------------------

% text / rules
\definecolor{DSTableText}{HTML}{2D2923}
\definecolor{DSTableRule}{HTML}{9B907D}
\definecolor{DSTableRuleSoft}{HTML}{BEB4A4}

% alternating row colours
\definecolor{DSTableRowLight}{HTML}{EEE9DE}
\definecolor{DSTableRowDark}{HTML}{DFD8CB}


% --------------------------------------------------------------------------
% Table
% --------------------------------------------------------------------------

\NewDocumentEnvironment{DSConditionsTable}{ O{} m +b }
{%
    \begin{tblr}{
        width = \linewidth,
        % Columns
        colspec = {#2},
        colsep = 6pt,
        rowsep = 4pt,
        % Header
        row{1} = {
            font = \bfseries,
            fg = DSTableText
        },
        % Alternating body colours
        row{even} = {
            bg = DSTableRowDark
        },
        row{odd[3]} = {
            bg = DSTableRowLight
        },
        % Horizontal lines:
        % 2 = below header
        % Z = bottom of table
        hline{2-Z} = {
            0.45pt,
            DSTableRule
        },
        % Vertical lines:
        % 2-Y = all internal column boundaries
        % 2-Z = only rows 2 through the final row
        vline{2-Y} = {2-Z}{
            0.45pt,
            DSTableRuleSoft,
            abovepos = -0.65,
            belowpos = -0.65
        },
        % Allow local overrides
        #1
    }
        #3
    \end{tblr}
}
{}